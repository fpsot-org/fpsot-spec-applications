{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpsot.org/schemas/applications/events/org.fpsot.applications.file.changed.schema.json",
  "$comment": "SPDX-License-Identifier: Community-Spec-1.0. FPSOT applications event data (APP-088). The data holds identifiers, codes and instants only, never a party id, a reference number, an answer, a name or an address. A consumer reads the file by its id. The CloudEvents attributes follow API-101, and the subject is the id of the file.",
  "title": "org.fpsot.applications.file.changed",
  "description": "A file moved to another state (APP-031, APP-088).",
  "type": "object",
  "required": [
    "fileId",
    "from",
    "to",
    "reason",
    "changedAt"
  ],
  "properties": {
    "fileId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "The file (APP-030)."
    },
    "from": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "in-review",
        "information-requested",
        "decided",
        "withdrawn",
        "closed"
      ],
      "description": "The previous state (APP-030)."
    },
    "to": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "in-review",
        "information-requested",
        "decided",
        "withdrawn",
        "closed"
      ],
      "description": "The new state (APP-030)."
    },
    "reason": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "The reason code of the move (APP-031)."
    },
    "decisionRecordId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "description": "The decision record, for a move to decided (APP-032)."
    },
    "changedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$",
      "description": "When the file moved (APP-031)."
    }
  },
  "additionalProperties": false
}
